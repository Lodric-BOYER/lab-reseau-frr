<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>Rapport de conformité netcheck — {{ status }}</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: -apple-system, Segoe UI, Roboto, sans-serif; margin: 2rem; max-width: 960px; }
  h1 { margin-bottom: 0.2em; font-size: 1.4em; }
  .meta { color: #57606a; font-size: 0.9em; }
  .verdict-conforme { color: #1a7f37; }
  .verdict-non-conforme { color: #cf222e; }
  .verdict-analyse-incomplete { color: #9a6700; }
  .counters { margin: 1em 0; }
  .badge { display: inline-block; padding: 0.15em 0.6em; border-radius: 1em; font-size: 0.85em; margin-right: 0.4em; white-space: nowrap; }
  .badge-critique { background: #ffebe9; color: #cf222e; border: 1px solid #cf222e55; }
  .badge-haute { background: #fff1e5; color: #bc4c00; border: 1px solid #bc4c0055; }
  .badge-moyenne { background: #fff8c5; color: #9a6700; border: 1px solid #9a670055; }
  .badge-basse { background: #ddf4ff; color: #0969da; border: 1px solid #0969da55; }
  .badge-unread { background: #fff8c5; color: #9a6700; border: 1px solid #9a670055; font-weight: bold; }
  .badge-info { background: #ddf4ff; color: #0969da; border: 1px solid #0969da55; }
  .badge-gap { background: #fff1e5; color: #bc4c00; border: 1px solid #bc4c0055; font-weight: bold; }
  .cause-gap { color: #bc4c00; font-weight: bold; }
  table { border-collapse: collapse; width: 100%; margin-top: 1em; }
  th, td { text-align: left; padding: 0.5em 0.7em; border-bottom: 1px solid #d0d7de; vertical-align: top; }
  th { background: #f6f8fa; }
  tr[hidden] { display: none; }
  .filters { margin: 1em 0; display: flex; gap: 1.2em; flex-wrap: wrap; align-items: center; font-size: 0.9em; }
  footer { margin-top: 2em; font-size: 0.8em; color: #57606a; border-top: 1px solid #d0d7de; padding-top: 1em; }
</style>
</head>
<body>

<h1>Rapport de conformité netcheck</h1>
<p class="meta">Généré le {{ generated_at }} — règles : <code>{{ rules_path }}</code></p>
{% if credentials %}<p class="meta">Identifiants :{% for kind, by_source in credentials.items() %}{% if by_source %} {{ kind }} ← {% for src, names in by_source.items() %}{{ src }} ({{ names|join(", ") }}){% if not loop.last %} ; {% endif %}{% endfor %}{% if not loop.last %} —{% endif %}{% endif %}{% endfor %}</p>{% endif %}
<p class="verdict-{{ {'CONFORME': 'conforme', 'NON CONFORME': 'non-conforme'}.get(status, 'analyse-incomplete') }}">
  <strong>{{ status }}</strong>
</p>
{% for line in scope_lines %}
<p class="meta snapshot-scope{% if line.startswith('ATTENTION') %} cause-gap{% endif %}">{{ line }}</p>
{% endfor %}

{% if derogations %}
<p class="meta"><strong>Dérogations</strong> : fichier <code>{{ derogations.file.path }}</code>, empreinte
SHA-256 <code>{{ derogations.file.sha256 }}</code>.</p>
{% endif %}

{% for n in coverage %}
<p class="meta coverage-note"><span class="badge badge-info">information (couverture)</span> {{ n.text }}</p>
{% endfor %}

{% if source %}
<p class="meta"><strong>Mode hors ligne</strong> (<code>check --config-dir</code>) : {{ source.devices|length }}
équipement(s) lu(s) depuis des fichiers, aucun équipement interrogé. Les règles qui lisent l'état collecté
(interfaces) sont <strong class="cause-gap">non évaluables</strong> hors ligne, sauf si la règle déclare
<code>sources: [live, snapshot]</code> : elle est alors « HORS PÉRIMÈTRE (source : hors ligne) » (voir la
section du même nom) ; sinon voir « NON ÉVALUABLE », cause « ÉTAT REQUIS (hors ligne) ».</p>
<table id="sources">
  <thead>
    <tr><th>Équipement</th><th>Driver</th><th>Fichier</th></tr>
  </thead>
  <tbody>
    {% for name, info in source.devices.items() %}
    <tr><td>{{ name }}</td><td>{{ info.driver }}</td><td><code>{{ info.file }}</code></td></tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

<div class="counters">
  {% for sev in ["critique", "haute", "moyenne", "basse"] %}
  <span class="badge badge-{{ sev }}">{{ counts[sev] }} {{ sev }}</span>
  {% endfor %}
  {% if derogations and derogations.derogated %}
  <span class="badge badge-info">{{ derogations.derogated|length }} dérogation(s)</span>
  {% endif %}
  {% if summary.config_lines_unread %}
  <span class="badge badge-unread">{{ summary.config_lines_unread }} ligne(s) de configuration non lue(s) ou incertaine(s)</span>
  {% endif %}
  {% if summary.config_files_not_audited %}
  <span class="badge badge-unread">{{ summary.config_files_not_audited }} fichier(s) non audité(s)</span>
  {% endif %}
  {% if summary.config_notes %}
  <span class="badge badge-info">{{ summary.config_notes }} information(s) d'analyse</span>
  {% endif %}
  {% if coverage %}
  <span class="badge badge-info">{{ coverage|length }} information(s) de couverture</span>
  {% endif %}
  {% if summary.not_applicable_not_implemented %}
  <span class="badge badge-gap">{{ summary.not_applicable_not_implemented }} règle(s) non implémentée(s) par leur driver</span>
  {% endif %}
  {% if summary.not_applicable_no_model %}
  <span class="badge badge-gap">{{ summary.not_applicable_no_model }} règle(s) non évaluable(s) hors ligne (état requis)</span>
  {% endif %}
</div>

<div class="filters">
  <span>
    {% for sev in ["critique", "haute", "moyenne", "basse"] %}
    <label><input type="checkbox" class="f-sev" value="{{ sev }}" checked> {{ sev }}</label>
    {% endfor %}
  </span>
  <label>Équipement :
    <select id="f-device">
      <option value="">Tous</option>
      {% for d in devices %}
      <option value="{{ d }}">{{ d }}</option>
      {% endfor %}
    </select>
  </label>
  <label>Catégorie :
    <select id="f-category">
      <option value="">Toutes</option>
      {% for c in categories %}
      <option value="{{ c }}">{{ c }}</option>
      {% endfor %}
    </select>
  </label>
</div>

<table id="violations">
  <thead>
    <tr><th>Gravité</th><th>Équipement</th><th>Catégorie</th><th>Règle</th><th>Détail</th></tr>
  </thead>
  <tbody>
    {% for v in violations %}
    <tr data-severity="{{ v.rule.severity }}" data-device="{{ v.device }}"
        data-category="{{ v.rule.category or '(sans catégorie)' }}">
      <td><span class="badge badge-{{ v.rule.severity }}">{{ v.rule.severity }}</span></td>
      <td>{{ v.device }}</td>
      <td>{{ v.rule.category or "—" }}</td>
      <td>
        {{ v.rule.id }}<br><small>{{ v.rule.description }}</small>
        {% if v.rule.references %}
        <br><small>Réf. :
          {% for ref in v.rule.references %}
            <a href="{{ ref.url }}" rel="noopener noreferrer">{{ ref.title }}</a>{% if not loop.last %}, {% endif %}
          {% endfor %}
        </small>
        {% endif %}
      </td>
      <td>{{ v.detail }}
        {% set note = reactivated.get((v.rule.id, v.device, v.subject or '')) %}
        {% if note %}<br><small class="cause-gap">{{ note }}</small>{% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<p id="no-match" hidden>Aucune non-conformité ne correspond aux filtres sélectionnés.</p>
{% if not violations %}
<p>Aucune non-conformité.</p>
{% endif %}

{% if derogations %}
<h2>Dérogations</h2>
<p class="meta">Fichier <code>{{ derogations.file.path }}</code> (SHA-256 <code>{{ derogations.file.sha256 }}</code>).
Une violation couverte par une dérogation en cours garde son statut <strong>DÉROGATION</strong> : elle reste
visible, avec sa justification, son validateur et sa date d'expiration, comptée à part et sans effet sur le
code retour. Une dérogation expirée ne couvre plus rien. Les textes sont masqués.</p>
{% if derogations.derogated %}
<table id="derogations">
  <thead>
    <tr><th>Statut</th><th>Gravité</th><th>Équipement</th><th>Objet</th><th>Règle</th><th>Justification</th>
        <th>Validée par</th><th>Expire le</th></tr>
  </thead>
  <tbody>
    {% for d in derogations.derogated %}
    <tr>
      <td><span class="badge badge-info">DÉROGATION</span></td>
      <td>{{ d.severity }}</td>
      <td>{{ d.device }}</td>
      <td><code>{{ d.object }}</code></td>
      <td>{{ d.rule_id }}<br><small>{{ d.detail }}</small></td>
      <td>{{ d.derogation_id }} : {{ d.justification }}</td>
      <td>{{ d.validated_by }} ({{ d.validated_on }})</td>
      <td>{{ d.expires }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p>Aucune violation n'est couverte par une dérogation.</p>
{% endif %}
{% if derogations.notes %}
<ul id="derogation-notes">
  {% for n in derogations.notes %}
  <li><span class="badge badge-info">{{ n.kind }}</span> {{ n.text }}</li>
  {% endfor %}
</ul>
{% endif %}
{% endif %}

{% if config_warnings %}
<h2>Analyse de la configuration</h2>
<p class="meta">Lignes que l'analyse n'a pas pu classer proprement. Une ligne <strong>non lue</strong>
empêche de conclure « conforme » (code retour 1 au minimum) : l'audit n'a pas lu toute la
configuration. Une ligne à <strong>structure incertaine</strong> (ex. une accolade fermante manque) est
lue, et ses violations sont rapportées, mais la place de ce qui suit est incertaine : même effet sur le
verdict. Une ligne lue mais <strong>ambiguë</strong> n'est qu'une information, sans effet sur le code
retour. Les secrets sont masqués.</p>
<table id="config-analysis">
  <thead>
    <tr><th>Équipement</th><th>Ligne</th><th>Statut</th><th>Raison</th><th>Texte</th></tr>
  </thead>
  <tbody>
    {% for w in config_warnings %}
    <tr>
      <td>{{ w.device }}</td>
      <td>{{ w.warning.line if w.warning.line else "—" }}</td>
      <td><span class="badge {{ 'badge-unread' if w.blocks_verdict else 'badge-info' }}">{{ warning_status(w) }}</span></td>
      <td>{{ w.warning.reason }}</td>
      <td><code>{{ w.warning.text }}</code></td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{% if gaps %}
<h2>NON ÉVALUABLE</h2>
<p class="meta">Règle(s) <strong class="cause-gap">non évaluable(s)</strong> sur un équipement : l'audit est
<strong>incomplet</strong> (code retour 1 au moins), jamais « conforme ». Trois causes :
<strong class="cause-gap">non implémenté</strong> (la règle concerne ce driver, mais il ne sait pas l'évaluer :
un trou de couverture), <strong class="cause-gap">équipement injoignable</strong> (il n'a pas pu être lu) et,
hors ligne seulement, <strong class="cause-gap">état requis</strong> (la règle lit l'état collecté de
l'équipement, que des fichiers de configuration ne contiennent pas).</p>
<table id="not-evaluable">
  <thead>
    <tr><th>Équipement</th><th>Règle</th><th>Cause</th><th>Raison</th></tr>
  </thead>
  <tbody>
    {% for na in gaps %}
    <tr>
      <td>{{ na.device }}</td>
      <td>{{ na.rule.id }}<br><small>{{ na.rule.description }}</small></td>
      <td><span class="cause-gap">{{ na_label(na) }}</span></td>
      <td>{{ na.reason }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{% if scope_groups %}
<h2>HORS PÉRIMÈTRE</h2>
<p class="meta">Exclusion <strong>déclarée</strong> par la règle (<code>drivers:</code> ou <code>sources:</code>) :
ni conforme, ni non-conformité, sans effet sur le verdict ni le code retour. Ce n'est pas un défaut, mais la liste
est donnée : une ligne par règle et périmètre, avec les équipements concernés.</p>
<table id="out-of-scope">
  <thead>
    <tr><th>Règle</th><th>Périmètre</th><th>Équipements</th></tr>
  </thead>
  <tbody>
    {% for g in scope_groups %}
    <tr>
      <td>{{ g.rule_id }}<br><small>{{ g.description }}</small></td>
      <td>{{ g.scope }}</td>
      <td>{{ g.devices|join(", ") }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

<footer>
  netcheck v{{ netcheck_version }} — outil en lecture seule. À n'utiliser sur un réseau réel
  qu'avec une autorisation écrite.
</footer>

<script>
(function () {
  "use strict";
  var sevBoxes = Array.prototype.slice.call(document.querySelectorAll(".f-sev"));
  var deviceSelect = document.getElementById("f-device");
  var categorySelect = document.getElementById("f-category");
  var rows = Array.prototype.slice.call(document.querySelectorAll("#violations tbody tr"));
  var noMatch = document.getElementById("no-match");

  // Filtrage pur DOM, comme le rapport de diff : on montre/cache des lignes déjà rendues et
  // échappées côté serveur (attribut "hidden"), sans jamais reconstruire de texte.
  function apply() {
    var activeSeverities = sevBoxes.filter(function (box) { return box.checked; })
      .map(function (box) { return box.value; });
    var activeDevice = deviceSelect.value;
    var activeCategory = categorySelect.value;
    var visibleCount = 0;

    rows.forEach(function (row) {
      var show = activeSeverities.indexOf(row.getAttribute("data-severity")) !== -1
        && (activeDevice === "" || row.getAttribute("data-device") === activeDevice)
        && (activeCategory === "" || row.getAttribute("data-category") === activeCategory);
      row.hidden = !show;
      if (show) { visibleCount += 1; }
    });

    noMatch.hidden = visibleCount !== 0;
  }

  sevBoxes.forEach(function (box) { box.addEventListener("change", apply); });
  deviceSelect.addEventListener("change", apply);
  categorySelect.addEventListener("change", apply);
  apply();
})();
</script>

</body>
</html>
