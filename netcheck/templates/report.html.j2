<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>Rapport netcheck — {{ verdict }}</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: -apple-system, Segoe UI, Roboto, sans-serif; margin: 2rem; max-width: 960px; }
  h1 { margin-bottom: 0.2em; font-size: 1.4em; }
  .meta { color: #57606a; font-size: 0.9em; }
  .verdict-OK { color: #1a7f37; }
  .verdict-ATTENTION { color: #9a6700; }
  .verdict-ÉCHEC { color: #cf222e; }
  .counters { margin: 1em 0; }
  .badge { display: inline-block; padding: 0.15em 0.6em; border-radius: 1em; font-size: 0.85em; margin-right: 0.4em; white-space: nowrap; }
  .badge-CRITIQUE { background: #ffebe9; color: #cf222e; border: 1px solid #cf222e55; }
  .badge-ATTENTION { background: #fff8c5; color: #9a6700; border: 1px solid #9a670055; }
  .badge-INFO { background: #ddf4ff; color: #0969da; border: 1px solid #0969da55; }
  .badge-PREVU { background: #dafbe1; color: #1a7f37; border: 1px solid #1a7f3755; }
  table { border-collapse: collapse; width: 100%; margin-top: 1em; }
  th, td { text-align: left; padding: 0.5em 0.7em; border-bottom: 1px solid #d0d7de; vertical-align: top; }
  th { background: #f6f8fa; }
  tr[hidden] { display: none; }
  .filters { margin: 1em 0; display: flex; gap: 1.2em; flex-wrap: wrap; align-items: center; font-size: 0.9em; }
  .filters label { margin-right: 0.6em; }
  pre.diff { background: #f6f8fa; padding: 0.7em; overflow-x: auto; white-space: pre-wrap; margin: 0.3em 0 0; }
  details summary { cursor: pointer; }
  footer { margin-top: 2em; font-size: 0.8em; color: #57606a; border-top: 1px solid #d0d7de; padding-top: 1em; }
</style>
</head>
<body>

<h1>Rapport netcheck</h1>
<p class="meta">Généré le {{ generated_at }} — comparaison <code>{{ before_name }}</code> → <code>{{ after_name }}</code></p>
<p class="verdict-{{ verdict }}"><strong>Verdict : {{ verdict }}</strong></p>

<div class="counters">
  <span class="badge badge-CRITIQUE">{{ counts.CRITIQUE }} critique(s)</span>
  <span class="badge badge-ATTENTION">{{ counts.ATTENTION }} attention</span>
  <span class="badge badge-INFO">{{ counts.INFO }} info</span>
  {% if planned_count %}
  <span class="badge badge-PREVU">{{ planned_count }} prévu(s)</span>
  {% endif %}
</div>

{% if after_results %}
<h2>États attendus (après le changement)</h2>
<table id="after-results">
  <thead>
    <tr><th>Statut</th><th>Équipement</th><th>Assertion</th><th>Détail</th></tr>
  </thead>
  <tbody>
    {% for r in after_results %}
    <tr>
      <td>{{ r.status.value }}</td>
      <td>{{ r.assertion.device }}</td>
      <td>{{ r.assertion.id }}<br><small>{{ r.assertion.description }}</small></td>
      <td>{{ r.detail }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

<div class="filters">
  <span>
    <label><input type="checkbox" class="f-sev" value="CRITIQUE" checked> Critique</label>
    <label><input type="checkbox" class="f-sev" value="ATTENTION" checked> Attention</label>
    <label><input type="checkbox" class="f-sev" value="INFO" checked> Info</label>
    {% if planned_count %}
    <label><input type="checkbox" class="f-sev" value="PREVU" checked> Prévu</label>
    {% endif %}
  </span>
  <label>Équipement :
    <select id="f-device">
      <option value="">Tous</option>
      {% for d in devices %}
      <option value="{{ d }}">{{ d }}</option>
      {% endfor %}
    </select>
  </label>
</div>

<table id="findings">
  <thead>
    <tr><th>Gravité</th><th>Équipement</th><th>Catégorie</th><th>Message</th></tr>
  </thead>
  <tbody>
    {% for f in findings %}
    <tr data-severity="{{ 'PREVU' if f.expected_by else f.severity.name }}" data-device="{{ f.device }}">
      <td>
        {% if f.expected_by %}
        <span class="badge badge-PREVU">PRÉVU</span> ({{ f.severity.name | lower }})<br>
        <small>critère : {{ f.expected_by }}</small>
        {% else %}
        <span class="badge badge-{{ f.severity.name }}">{{ f.severity.name }}</span>
        {% endif %}
      </td>
      <td>{{ f.device }}</td>
      <td>{{ f.category }}</td>
      <td>
        {% if f.category == "config" %}
        <details><summary>diff de configuration</summary><pre class="diff">{{ f.message }}</pre></details>
        {% else %}
        {{ f.message }}
        {% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<p id="no-match" hidden>Aucun constat ne correspond aux filtres sélectionnés.</p>
{% if not findings %}
<p>Aucun constat.</p>
{% endif %}

<footer>
  netcheck v{{ netcheck_version }} — outil en lecture seule. À n'utiliser sur un réseau réel
  qu'avec une autorisation écrite.
</footer>

<script>
(function () {
  "use strict";
  var sevBoxes = Array.prototype.slice.call(document.querySelectorAll(".f-sev"));
  var deviceSelect = document.getElementById("f-device");
  var rows = Array.prototype.slice.call(document.querySelectorAll("#findings tbody tr"));
  var noMatch = document.getElementById("no-match");

  // Filtrage pur DOM : on montre/cache des lignes déjà rendues et échappées côté serveur,
  // via l'attribut "hidden". Aucun texte n'est reconstruit ni réinjecté dans la page.
  function apply() {
    var activeSeverities = sevBoxes.filter(function (box) { return box.checked; })
      .map(function (box) { return box.value; });
    var activeDevice = deviceSelect.value;
    var visibleCount = 0;

    rows.forEach(function (row) {
      var show = activeSeverities.indexOf(row.getAttribute("data-severity")) !== -1
        && (activeDevice === "" || row.getAttribute("data-device") === activeDevice);
      row.hidden = !show;
      if (show) { visibleCount += 1; }
    });

    noMatch.hidden = visibleCount !== 0;
  }

  sevBoxes.forEach(function (box) { box.addEventListener("change", apply); });
  deviceSelect.addEventListener("change", apply);
  apply();
})();
</script>

</body>
</html>
