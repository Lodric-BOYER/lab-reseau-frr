# Python
__pycache__/
*.pyc
.venv/

# Images de routeurs téléchargées (compte constructeur, licence : jamais redistribuées ni commitées)
# -- par ex. cEOS-lab-4.34.8M.tar.xz (Phase F) ; l'image importée vit dans Docker, pas ici.
# Motifs volontairement limités aux extensions d'archive : un motif sur le NOM (cEOS*) ignorerait
# aussi, par ex., un futur cEOS-notes.md.
*.tar
*.tar.xz
*.tar.gz
*.tgz
*.txz

# Fichiers générés par containerlab au déploiement
clab-*/
.lab.clab.yml.bak

# Sorties des scripts (propres à chaque machine)
automation/backups/
automation/baseline/
drift_report.md
automation/*.md

# netcheck : snapshots et rapports contiennent des configurations (C4)
snapshots/
reports/
.pytest_cache/

# Métadonnées Windows ("mark of the web") copiées par erreur dans le dépôt
*:Zone.Identifier

# Phase C : clés SSH, known_hosts épinglé et secrets générés par les scripts de lab (jamais commités, C15)
lab-access/.keys/
lab-access/**/.env
lab-access/**/.env.*
