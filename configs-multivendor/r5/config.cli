set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 description vers-r4
set / interface ethernet-1/1 mtu 1514
set / interface ethernet-1/1 subinterface 0 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 10.2.45.2/30
set / interface ethernet-1/1 subinterface 0 ip-mtu 1500
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 description LAN-pc2
set / interface ethernet-1/2 subinterface 0 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 192.168.2.1/24
set / interface lo0 admin-state enable
set / interface lo0 subinterface 0 admin-state enable
set / interface lo0 subinterface 0 ipv4 admin-state enable
set / interface lo0 subinterface 0 ipv4 address 10.2.255.5/32
set / network-instance default interface ethernet-1/1.0
set / network-instance default interface ethernet-1/2.0
set / network-instance default interface lo0.0
set / network-instance default protocols ospf instance main admin-state enable
set / network-instance default protocols ospf instance main version ospf-v2
set / network-instance default protocols ospf instance main router-id 10.2.255.5
set / network-instance default protocols ospf instance main area 0.0.0.0 interface ethernet-1/1.0 interface-type point-to-point
set / network-instance default protocols ospf instance main area 0.0.0.0 interface ethernet-1/2.0 passive true
set / network-instance default protocols ospf instance main area 0.0.0.0 interface lo0.0 passive true
set / system authentication keychain kc-ospf-r4r5 admin-state enable
set / system authentication keychain kc-ospf-r4r5 type ospf
set / system authentication keychain kc-ospf-r4r5 key 1 algorithm md5
set / system authentication keychain kc-ospf-r4r5 key 1 authentication-key lab-ospf-r4r5
set / network-instance default protocols ospf instance main area 0.0.0.0 interface ethernet-1/1.0 authentication keychain kc-ospf-r4r5
set / system banner login-banner "Acces reserve - lab de demonstration - toute activite peut etre journalisee"
set / interface ethernet-1/1 subinterface 0 ipv6 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv6 address 2001:db8:2:45::3/127
set / interface ethernet-1/2 subinterface 0 ipv6 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv6 address 2001:db8:a2::1/64
set / interface lo0 subinterface 0 ipv6 admin-state enable
set / interface lo0 subinterface 0 ipv6 address 2001:db8:2:ff::5/128
set / network-instance default protocols ospf instance v3 admin-state enable
set / network-instance default protocols ospf instance v3 version ospf-v3
set / network-instance default protocols ospf instance v3 router-id 10.2.255.5
set / network-instance default protocols ospf instance v3 address-family ipv6-unicast
set / network-instance default protocols ospf instance v3 area 0.0.0.0 interface ethernet-1/1.0 interface-type point-to-point
set / network-instance default protocols ospf instance v3 area 0.0.0.0 interface ethernet-1/2.0 passive true
set / network-instance default protocols ospf instance v3 area 0.0.0.0 interface lo0.0 passive true
