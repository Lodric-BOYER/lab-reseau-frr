! r4 : Arista cEOS (Phase F, O6) -- remplace le r4 FRR de configs/r4/frr.conf, MEME logique :
!   - OSPF area 0 vers r5, authentification message-digest (MD5), lien point-a-point ;
!   - eBGP AS65002 <-> r3 (AS65001) : TCP-MD5, GTSM (ttl maximum-hops 1), maximum-routes 10,
!     filtrage entrant et sortant par prefix-list + route-map ;
!   - agregat 10.2.0.0/16 porte par une route de rejet Null0 ; redistribution BGP -> OSPF.
! Les secrets sont ceux du lab FRR (lab uniquement, C11) ; EOS les stocke ensuite en « type 7 »
! dans la running-config (reversible : traite comme un secret par netcheck/secrets.py).
! Syntaxe verifiee EN DIRECT sur cEOS 4.34.8M (aucune commande devinee) ; les lignes de plate-forme
! (aaa, utilisateur admin par defaut de l'image, multi-agent) reprennent la configuration par
! defaut generee par containerlab. Differences voulues avec cette configuration par defaut :
!   - AUCUNE API de gestion (eAPI, gNMI, NETCONF) : seul SSH est utilise, et un lab de securite
!     n'expose pas d'API inutiles (la regle de conformite eos-api-gestion-exposee le verifie) ;
!   - pas de route par defaut via Management0 : elle n'a pas de role ici et polluerait la table
!     de routage de r4.
!
no aaa root
!
username admin privilege 15 role network-admin secret sha512 $6$BfyQeqMEAOYfFIFW$2TgamS6RUy/xvOEvKUwPWTVOBo3/XKjMOv0OJc1jq0e5avT1XGjkSpRvtprKpxM3u/HbtqsRiDweed98L7PYS.
!
! Phase C5 : compte netcheck-ro en LECTURE SEULE. Sans les deux lignes aaa, un rôle n'est PAS appliqué (observé
! sur cEOS 4.34.8M : configure, copy et même bash passaient). `exec` attribue le rôle à l'ouverture de session,
! `commands` autorise chaque commande. EOS évalue la commande SANS « | json » (format de sortie, pas un filtre) ;
! les expressions sont ancrées (^...$), sinon « show ip bgp » laisserait passer « show ip bgp neighbors ».
! Les refus finaux sont explicites (exec, configuration, tout). network-operator n'est PAS en lecture seule
! (copy running-config file: passe). L'utilisateur et sa clé publique sont posés par lab-access/accounts_lab.sh.
aaa authorization exec default local
aaa authorization commands all default local
!
role netcheck-ro
   10 permit mode exec command ^enable$
   20 permit mode exec command ^terminal (width|length) [0-9]+$
   30 permit mode exec command ^show interfaces$
   40 permit mode exec command ^show ipv6 interface$
   50 permit mode exec command ^show vrf$
   60 permit mode exec command ^show ip route vrf all$
   70 permit mode exec command ^show ipv6 route vrf all$
   80 permit mode exec command ^show ip ospf neighbor$
   90 permit mode exec command ^show ospfv3 neighbor$
   100 permit mode exec command ^show ip bgp summary$
   110 permit mode exec command ^show ip bgp$
   120 permit mode exec command ^show ipv6 bgp summary$
   130 permit mode exec command ^show ipv6 bgp$
   140 permit mode exec command ^show running-config$
   150 deny mode exec command .*
   160 deny mode config command .*
   170 deny mode config-all command .*
   180 deny command .*
!
no service interface inactive port-id allocation disabled
!
transceiver qsfp default-mode 4x10G
!
service routing protocols model multi-agent
!
hostname r4
!
spanning-tree mode mstp
!
system l1
   unsupported speed action error
   unsupported error-correction action error
!
interface Ethernet1
   description eBGP-vers-r3-AS65001
   no switchport
   ip address 172.16.34.2/30
   ipv6 address 2001:db8:34::3/127
   ip ospf area 0.0.0.0
   ospfv3 ipv6 area 0.0.0.0
   ospfv3 passive
!
interface Ethernet2
   description vers-r5
   no switchport
   ip address 10.2.45.1/30
   ipv6 address 2001:db8:2:45::2/127
   ip ospf network point-to-point
   ip ospf authentication message-digest
   ip ospf message-digest-key 1 md5 lab-ospf-r4r5
   ip ospf area 0.0.0.0
   ospfv3 ipv6 area 0.0.0.0
   ospfv3 network point-to-point
!
interface Loopback0
   ip address 10.2.255.4/32
   ipv6 address 2001:db8:2:ff::4/128
   ip ospf area 0.0.0.0
   ospfv3 ipv6 area 0.0.0.0
   ospfv3 passive
!
interface Management0
   ip address 172.20.22.14/24
!
ip routing
!
ipv6 unicast-routing
!
! Route de rejet pour l'agregat annonce en BGP (bonne pratique operateur)
ip route 10.2.0.0/16 Null0
ipv6 route 2001:db8:2::/48 Null0
!
ip prefix-list PL-EBGP-OUT seq 10 permit 10.2.0.0/16
ip prefix-list PL-EBGP-OUT seq 20 permit 192.168.2.0/24
ip prefix-list PL-EBGP-IN seq 10 permit 10.1.0.0/16
ip prefix-list PL-EBGP-IN seq 20 permit 192.168.1.0/24
!
ipv6 prefix-list PL6-EBGP-OUT
   seq 10 permit 2001:db8:2::/48
   seq 20 permit 2001:db8:a2::/64
!
ipv6 prefix-list PL6-EBGP-IN
   seq 10 permit 2001:db8:1::/48
   seq 20 permit 2001:db8:a1::/64
!
route-map RM-EBGP-IN permit 10
   match ip address prefix-list PL-EBGP-IN
!
route-map RM-EBGP-OUT permit 10
   match ip address prefix-list PL-EBGP-OUT
!
route-map RM6-EBGP-IN permit 10
   match ipv6 address prefix-list PL6-EBGP-IN
!
route-map RM6-EBGP-OUT permit 10
   match ipv6 address prefix-list PL6-EBGP-OUT
!
router ospf 1
   router-id 10.2.255.4
   passive-interface Ethernet1
   passive-interface Loopback0
   redistribute bgp
!
router ospfv3
   router-id 10.2.255.4
   address-family ipv6
      redistribute bgp
!
router bgp 65002
   router-id 10.2.255.4
   neighbor 172.16.34.1 remote-as 65001
   neighbor 172.16.34.1 description r3-AS65001
   neighbor 172.16.34.1 password lab-bgp-r3r4
   neighbor 172.16.34.1 ttl maximum-hops 1
   neighbor 172.16.34.1 maximum-routes 10
   neighbor 172.16.34.1 route-map RM-EBGP-IN in
   neighbor 172.16.34.1 route-map RM-EBGP-OUT out
   network 10.2.0.0/16
   neighbor 2001:db8:34::2 remote-as 65001
   neighbor 2001:db8:34::2 description r3-AS65001-v6
   neighbor 2001:db8:34::2 ttl maximum-hops 1
   neighbor 2001:db8:34::2 password lab-bgp-v6r3r4
   neighbor 2001:db8:34::2 maximum-routes 10
   network 192.168.2.0/24
   !
   address-family ipv4
      no neighbor 2001:db8:34::2 activate
   !
   address-family ipv6
      neighbor 2001:db8:34::2 activate
      neighbor 2001:db8:34::2 route-map RM6-EBGP-IN in
      neighbor 2001:db8:34::2 route-map RM6-EBGP-OUT out
      network 2001:db8:2::/48
      network 2001:db8:a2::/64
!
router multicast
   ipv4
      software-forwarding kernel
   !
   ipv6
      software-forwarding kernel
!
end
